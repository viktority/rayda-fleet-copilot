# Copy to .env.local for a separate checkout; never commit credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol
# Dataset and durable application state, relative to the working directory.
FLEET_DATASET=data/raw/device-telemetry-dataset.ndjson
FLEET_DB=runtime/fleet.sqlite3
# JSON mapping of independent bearer tokens to trusted actor/tenant/role bindings.
# The CLI is a trusted, local operator interface. The HTTP API refuses to start
# until this mapping is configured; there is no development auth bypass.
FLEET_API_TOKENS={}
